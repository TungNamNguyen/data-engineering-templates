AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# Redis
REDIS_PASSWORD=

# Airflow webserver login
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=changeme

# Fernet key for encrypting connections/variables
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# JWT auth for API (Airflow 3.x)
AIRFLOW_JWT_SECRET=changeme
AIRFLOW_JWT_ISSUER=airflow
