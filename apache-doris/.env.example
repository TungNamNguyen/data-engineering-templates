# Apache Doris Configuration
# Copy this file to .env and adjust values as needed.

# FE (Frontend) Configuration
FE_IMAGE=apache/doris:fe-3.0.3
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030
FE_EDIT_LOG_PORT=9010

# BE (Backend) Configuration
BE_IMAGE=apache/doris:be-3.0.3
BE_HEARTBEAT_PORT=9050
BE_WEBSERVER_PORT=8040

# Doris root password (set for production, leave empty for local dev)
DORIS_ROOT_PASSWORD=
