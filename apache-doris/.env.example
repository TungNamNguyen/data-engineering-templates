# Apache Doris Configuration
# Copy this file to .env and adjust values as needed.

# FE (Frontend) Configuration
FE_IMAGE=apache/doris:fe-3.0.8
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030
FE_EDIT_LOG_PORT=9010

# BE (Backend) Configuration
BE_IMAGE=apache/doris:be-3.0.8
BE_HEARTBEAT_PORT=9050
BE_WEBSERVER_PORT=8040

# Host interface for the unauthenticated admin HTTP ports (FE 8030, BE 8040).
# 127.0.0.1 = reachable only from this host. Set to 0.0.0.0 to expose them
# (e.g. Stream Load from another machine) — then firewall or reverse-proxy them.
ADMIN_BIND_ADDR=127.0.0.1

# Root password is NOT set here — a fresh cluster starts with a passwordless
# root and the image's env-var hook is unreliable. Set it once after first
# startup (see README "First-time setup"):
#   SET PASSWORD FOR 'root' = PASSWORD('your-password');
