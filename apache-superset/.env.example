# Apache Superset Configuration
# Copy this file to .env and adjust values before `docker compose up -d`.

# Image — pin a version for reproducibility
SUPERSET_IMAGE=apache/superset:4.1.1

# Host port for the Superset web UI
SUPERSET_PORT=8088

# REQUIRED: random 32+ byte secret used to sign sessions and encrypt secrets.
# Generate one with: openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE_ME_openssl_rand_base64_42

# Admin user created on first startup (by the superset-init one-shot)
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@superset.local
SUPERSET_ADMIN_FIRSTNAME=Superset
SUPERSET_ADMIN_LASTNAME=Admin

# Metadata database (internal Postgres — not your analytics warehouse)
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset

# Celery worker concurrency (async SQL Lab queries, alerts, reports)
CELERY_WORKER_CONCURRENCY=4

# Set to "yes" to load the built-in example dashboards on first init
SUPERSET_LOAD_EXAMPLES=no

# Extra SQLAlchemy drivers for connecting to warehouses.
# Installed at container start — no image rebuild needed.
# Example:
#   ADDITIONAL_PIP_PACKAGES=clickhouse-connect==0.8.6 duckdb-engine==0.13.2 pymssql==2.3.0 trino==0.330.0
ADDITIONAL_PIP_PACKAGES=
