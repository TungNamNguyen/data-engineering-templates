# ClickHouse Configuration
# Copy this file to .env and adjust values as needed.

# Image
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8

# Credentials (applied on first startup; set before `docker compose up -d`)
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# Data-engineering service accounts (created by initdb.d on first startup).
# Avoid single quotes in these values — they are interpolated into SQL.
TRANSFORM_USER_PASSWORD=transform
READ_USER_PASSWORD=read

# Host port mappings (change if you have port conflicts on the host)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
