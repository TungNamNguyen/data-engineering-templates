# PostgreSQL Configuration
# Copy this file to .env and adjust values as needed.

# Image — pin a major version for reproducibility
POSTGRES_IMAGE=postgres:16-alpine

# Credentials (applied on first startup; set before `docker compose up -d`)
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host port mapping (change if you have port conflicts on the host)
POSTGRES_PORT=5432
