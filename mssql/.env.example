# Microsoft SQL Server Configuration
# Copy this file to .env and adjust values as needed.

# Image — pin a major version for reproducibility
# Tags: 2022-latest, 2019-latest. Use mcr.microsoft.com/azure-sql-edge for ARM64 hosts.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# Edition: Developer (free, full feature set), Express, Standard, Enterprise, EnterpriseCore
MSSQL_PID=Developer

# SA password — MUST be at least 8 characters and contain 3 of:
# uppercase, lowercase, digits, non-alphanumeric symbols.
# The entrypoint refuses to start if this policy is not met.
MSSQL_SA_PASSWORD=Your_strong_Password123

# Application database and user created by initdb.d on first startup
MSSQL_DATABASE=app
MSSQL_USER=mssql
MSSQL_PASSWORD=Your_strong_Password123

# Data-engineering service accounts (created by initdb.d on first startup).
# SQL Server enforces a password policy by default, but CHECK_POLICY=OFF
# is used in 01-infra-setup.sh so these values do not have to meet it.
# Still, avoid single quotes — they are interpolated into T-SQL.
TRANSFORM_USER_PASSWORD=Transform_Password123
READ_USER_PASSWORD=Read_Password123

# Host port mapping (change if you have port conflicts on the host)
MSSQL_PORT=1433

# Collation used when the container initializes a fresh data directory
MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS
