# dbt connection — read by profiles.yml via env_var().
# Defaults below match the postgres/ template's transform_user account.

DBT_HOST=localhost
DBT_PORT=5432
DBT_DATABASE=app
DBT_USER=transform_user
DBT_PASSWORD=changeme
DBT_SCHEMA=raw
DBT_SSLMODE=prefer

# CI / CD — used by the `ci` profile target (optional).
# CI_PIPELINE_ID=12345
