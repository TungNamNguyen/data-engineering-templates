# DuckDB Configuration
# Copy this file to .env and adjust values as needed. All variables have
# defaults in docker-compose.yml — this file is optional.

# Upstream official image tag. Also used as the init sidecar build arg
# so the embedded binary stays in lock-step with the main service.
DUCKDB_VERSION=1.4.0

# Database file name under ./data on the host (bind-mounted to /data).
DUCKDB_DB=app.duckdb
