# MySQL Configuration
# Copy this file to .env and adjust values as needed.

# Image — pin a major version for reproducibility (8.4 is the current LTS)
MYSQL_IMAGE=mysql:8.4

# Credentials (applied on first startup; set before `docker compose up -d`)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=mysql
MYSQL_PASSWORD=mysql

# Data-engineering service accounts (created by initdb.d on first startup).
# Avoid single quotes in these values — they are interpolated into SQL.
TRANSFORM_USER_PASSWORD=transform
READ_USER_PASSWORD=read

# Host port mapping (change if you have port conflicts on the host)
MYSQL_PORT=3306
