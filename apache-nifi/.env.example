
NIFI_IMAGE=apache/nifi:2.10.0
NIFI_REGISTRY_IMAGE=apache/nifi-registry:2.8.0

# Web UI login. The password MUST be at least 12 characters — otherwise NiFi
# ignores it and generates a random username/password
NIFI_USERNAME=admin
NIFI_PASSWORD=change-me-at-least-12-chars

# Key that encrypts sensitive processor properties (DB passwords, API tokens).
# Generate one: openssl rand -base64 24
NIFI_SENSITIVE_PROPS_KEY=change-me-at-least-12-chars

# Host:port allowed in the HTTP Host header. Must match how you reach the UI.
# Comma-separate to add a reverse-proxy hostname or public DNS name, e.g.
# "localhost:8443,nifi.example.com".
NIFI_WEB_PROXY_HOST=localhost:8443

NIFI_JVM_HEAP_INIT=2g
NIFI_JVM_HEAP_MAX=2g

NIFI_HTTPS_PORT=8443
NIFI_REGISTRY_PORT=18080
