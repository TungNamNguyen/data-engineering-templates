# Metabase Configuration
# Copy this file to .env and adjust values before `docker compose up -d`.

# Image — pin a version for reproducibility
METABASE_IMAGE=metabase/metabase:v0.52.4

# Host port for the Metabase web UI
METABASE_PORT=3000

# Public URL — used for email links, embeds, and public sharing
MB_SITE_URL=http://localhost:3000
MB_SITE_NAME=Metabase

# REQUIRED for production: random 32+ byte key used to encrypt saved
# database connection credentials inside the application DB.
# Generate one with: openssl rand -base64 32
MB_ENCRYPTION_SECRET_KEY=CHANGE_ME_openssl_rand_base64_32

# Application (metadata) database — internal Postgres, not your warehouse
POSTGRES_DB=metabase
POSTGRES_USER=metabase
POSTGRES_PASSWORD=metabase

# JVM heap for the Metabase process. Bump on larger instances.
JAVA_OPTS=-Xmx2g

# Timezone used by the JVM (affects scheduled pulses, report timestamps)
MB_TIMEZONE=UTC

# Password complexity policy: weak | normal | strong
MB_PASSWORD_COMPLEXITY=normal
